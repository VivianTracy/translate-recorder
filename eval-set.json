{
  "eval_set_id": "aco_mission_eval_v1",
  "title": "ACO mission English ↔ Wolof eval v1",
  "frozen_at": "2026-09-13",
  "purpose": "Scorable two-way speech-translation eval for the offline English ↔ Wolof clinic/mission translator. Not a training corpus.",
  "languages": {
    "gold": ["en", "wo"],
    "cues_only": ["fr", "zh"]
  },
  "gold_policy": "English is frozen gold. Wolof gold must be written by a native speaker on this exact wording. Do not fill wo_gold from a model. French and Chinese are cue cards for contributors, not MT references.",
  "recording_protocol": {
    "pass_a": {
      "spoken_language": "en",
      "who": "TTS (macos_say / Samantha), stored as contributor tts_en_v1",
      "reads": "en_gold, exactly as written",
      "scores": ["EN→WO speech translation", "Wolof TTS listenability"]
    },
    "pass_b": {
      "spoken_language": "wo",
      "who": "At least two native Wolof speakers",
      "reads": "wo_gold, exactly as written, after gold is filled",
      "scores": ["WO ASR", "WO→EN translation", "English TTS listenability"]
    },
    "take_rules": [
      "Pass A is generated and uploaded to Supabase; do not recruit English speakers",
      "Quiet room for Pass B, phone 20–30 cm from the mouth",
      "One phrase per take",
      "Mark take_quality keep / redo / noisy",
      "Target 24 TTS English clips plus ~24–48 Wolof clips"
    ]
  },
  "scoring": {
    "pass_a": {
      "hypothesis": "pipeline Wolof text",
      "reference": "wo_gold",
      "metrics": ["BLEU", "chrF", "human 1–5 meaning"]
    },
    "pass_b_asr": {
      "hypothesis": "pipeline Wolof transcript",
      "reference": "wo_gold",
      "metrics": ["WER", "CER"]
    },
    "pass_b_mt": {
      "hypothesis": "pipeline English text",
      "reference": "en_gold",
      "metrics": ["BLEU", "chrF", "human 1–5 meaning"]
    },
    "tts": {
      "metrics": ["human 1–5 listenability"]
    }
  },
  "export_manifest_fields": [
    "eval_set_id",
    "phrase_id",
    "phrase_key",
    "spoken_language",
    "recording_pass",
    "gold_text",
    "gold_translation",
    "speaker_id",
    "native_language",
    "take_quality",
    "duration_sec",
    "audio_path"
  ],
